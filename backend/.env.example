# ---- Django ----
# Which settings module to load. Defaults to config.settings.dev when unset.
# Uncomment to run against production settings instead:
# DJANGO_SETTINGS_MODULE=config.settings.prod

# Set DEBUG=False in production. Never commit the real .env file.
DEBUG=True
SECRET_KEY=change-me-generate-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# These are read by Django (see config/env.py) and also fed to the Postgres
# container by docker-compose. DB_HOST/DB_PORT are how the app reaches the DB:
#   - Django run on the host machine: DB_HOST=localhost, DB_PORT=5435 (mapped)
#   - Django run inside docker-compose: DB_HOST=db, DB_PORT=5432
DB_NAME=pipely
DB_USER=pipely
DB_PASSWORD=pipely
DB_HOST=localhost
DB_PORT=5435
DB_SSLMODE=prefer
